{
  "name": "@silvermoon-work/ipfs-payload",
  "version": "0.0.0",
  "description": "Typed content references and pure JSON/DAG-CBOR payload codecs.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./typebox": {
      "types": "./dist/typebox.d.ts",
      "import": "./dist/typebox.js"
    },
    "./dag-cbor": {
      "types": "./dist/dag-cbor.d.ts",
      "import": "./dist/dag-cbor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ipld/dag-cbor": "catalog:",
    "@sinclair/typebox": "catalog:",
    "ajv": "catalog:",
    "cborg": "catalog:",
    "multiformats": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/task-engine.git",
    "directory": "packages/ipfs-payload"
  },
  "homepage": "https://github.com/silvermoon-work/task-engine/tree/main/packages/ipfs-payload#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/task-engine/issues"
  }
}
