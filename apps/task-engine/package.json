{
  "name": "task-engine-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "node --test",
    "typecheck": "tsc -b --pretty false",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@silvermoon-work/task-engine-cli": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
