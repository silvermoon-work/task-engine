{
  "name": "@silvermoon-work/ipfs-access",
  "version": "0.0.0",
  "description": "Type-only CID content access and streaming file/directory contracts.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "multiformats": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/task-engine.git",
    "directory": "packages/ipfs-access"
  },
  "homepage": "https://github.com/silvermoon-work/task-engine/tree/main/packages/ipfs-access#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/task-engine/issues"
  }
}
