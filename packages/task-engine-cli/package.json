{
  "name": "@silvermoon-work/task-engine-cli",
  "version": "0.2.0-rc.7",
  "description": "Managed local Task Engine server and persistent task CLI.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "task-engine": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@ipld/dag-cbor": "catalog:",
    "blockstore-core": "catalog:",
    "multiformats": "catalog:",
    "ipfs-unixfs-exporter": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "ipfs-unixfs": "catalog:",
    "@silvermoon-work/task-engine": "workspace:*",
    "@silvermoon-work/task-protocol": "workspace:*"
  },
  "devDependencies": {
    "@silvermoon-work/task-builder": "workspace:*",
    "@silvermoon-work/task-builder-cli": "workspace:*",
    "@silvermoon-work/task-sdk": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/task-engine.git",
    "directory": "packages/task-engine-cli"
  },
  "homepage": "https://github.com/silvermoon-work/task-engine/tree/main/packages/task-engine-cli#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/task-engine/issues"
  }
}
