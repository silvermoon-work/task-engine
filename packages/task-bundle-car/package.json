{
  "name": "@silvermoon-work/task-bundle-car",
  "version": "0.1.0-canary-261110-1",
  "description": "Compiler-free Task Bundle CAR encoding, validation and read-only file trees.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"for (const path of ['dist', '.cache']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "lint": "biome lint .",
    "test": "tsx --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@silvermoon-work/task-protocol": "workspace:*",
    "multiformats": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "ipfs-unixfs-exporter": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/task-engine.git",
    "directory": "packages/task-bundle-car"
  },
  "homepage": "https://github.com/silvermoon-work/task-engine/tree/main/packages/task-bundle-car#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/task-engine/issues"
  }
}
