  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/task-engine.git",
    "directory": "packages/task-engine-http"
  },
  "homepage": "https://github.com/silvermoon-work/task-engine/tree/main/packages/task-engine-http#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/task-engine/issues"
